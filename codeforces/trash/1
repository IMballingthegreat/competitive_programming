#include <bits/stdc++.h>

void solve(){
    int n{};
    std::cin >> n;
    while(n--){
        std::string s;
        std::cin >> s;
        std::unordered_map<std::string, int>mp;
        for(char c:s){
            mp[c]++;
        }
        int mx = 0;
        for(auto &c:mp){
            if(mp.second>mx){
                mx = mp.second;
            }
        }
        std::cout << mx;
    }
}
int main(){
    solve();
    return 0;
}
